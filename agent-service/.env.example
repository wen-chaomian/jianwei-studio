# Copy to .env; credentials are local only. Java studio.agent.internal-token must match.
AGENT_DATABASE_URL=postgresql://shiguang_agent:CHANGE_ME@127.0.0.1:5432/shiguang_agent
AGENT_INTERNAL_TOKEN=
AGENT_DEEPSEEK_API_KEY=
AGENT_DEEPSEEK_MODEL=
AGENT_MODEL_TIMEOUT_SECONDS=120
AGENT_ENCRYPTION_KEY=
# Local RocketMQ: setup-mq.mjs writes generated credentials into .env.
AGENT_MQ_ENABLED=true
AGENT_MQ_ENDPOINT=127.0.0.1:8081
AGENT_MQ_ACCESS_KEY=
AGENT_MQ_SECRET_KEY=
# Enable only for the local .local/rocketmq installation, not remote deployment.
AGENT_MQ_AUTOSTART=false
AGENT_MQ_MAX_CONCURRENCY=8
